---
import Icon from './Icon.astro';

interface Props {
  id: string;
  label: string;
  title: string;
  body: string;
  bullets: { icon: string; title: string; body: string }[];
  reverse?: boolean;
  note?: string;
  noteIcon?: string;
  tone?: 'white' | 'cream';
}
const { id, label, title, body, bullets, reverse = false, note, noteIcon = 'lock', tone = 'white' } = Astro.props;
---

<section class:list={['feature', `feature-${tone}`, { 'feature-reverse': reverse }]} id={id}>
  <div class="wrap feature-grid">
    <div class="feature-copy">
      <span class="feature-label">{label}</span>
      <h2>{title}</h2>
      <p class="feature-body">{body}</p>

      <ul class="feature-list">
        {bullets.map((bullet) => (
          <li>
            <span class="feature-icon" aria-hidden="true"><Icon name={bullet.icon} size={19} /></span>
            <span>
              <strong>{bullet.title}</strong>
              <span>{bullet.body}</span>
            </span>
          </li>
        ))}
      </ul>

      {note && <p class="feature-note"><Icon name={noteIcon} size={14} />{note}</p>}
    </div>

    <div class="feature-visual">
      <slot />
    </div>
  </div>
</section>
