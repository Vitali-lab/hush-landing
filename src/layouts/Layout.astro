---
import '../styles/global.css';
import { getCopy, type Lang } from '../i18n';
import { absolute, asset, canonical, home } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getCopy(lang);
const enUrl = absolute('');
const ruUrl = absolute('ru/');
const canonicalUrl = canonical(lang);
const ogImage = absolute('og.png');
const ogLocale = lang === 'ru' ? 'ru_RU' : 'en_US';
const updated = new Date().toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${enUrl}#organization`,
      name: 'Hush',
      url: enUrl,
      logo: { '@type': 'ImageObject', url: absolute('icon-512.png'), width: 512, height: 512 },
      sameAs: [c.common.repo],
    },
    {
      '@type': 'WebSite',
      '@id': `${enUrl}#website`,
      url: enUrl,
      name: 'Hush',
      description: c.meta.description,
      inLanguage: ['en', 'ru'],
      publisher: { '@id': `${enUrl}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: c.meta.title,
      description: c.meta.description,
      inLanguage: lang,
      isPartOf: { '@id': `${enUrl}#website` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
      dateModified: updated,
      about: { '@id': `${enUrl}#software` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${enUrl}#software`,
      name: 'Hush',
      alternateName: 'Hush — on-device dictation for macOS',
      applicationCategory: 'ProductivityApplication',
      applicationSubCategory: 'Dictation',
      operatingSystem: 'macOS 14 or newer, Apple Silicon; Windows 11 x64 (beta)',
      softwareVersion: '1.2.1',
      softwareRequirements: 'macOS 14+, Apple Silicon; Windows 11 x64 with AVX2',
      description: c.meta.description,
      url: enUrl,
      image: ogImage,
      screenshot: [absolute('img/shots/model.webp'), absolute('img/shots/setup-en.webp')],
      downloadUrl: c.common.downloadUrl,
      installUrl: c.common.repo,
      sameAs: [c.common.repo],
      inLanguage: ['en', 'ru'],
      isAccessibleForFree: true,
      license: 'https://opensource.org/license/mit',
      featureList: [
        'On-device dictation for macOS and Windows',
        'Works in any app at the focused cursor',
        'Whisper on the Apple Neural Engine or on the CPU',
        'Offline after a one-time model download',
        'English and Russian recognition',
        'Configurable keyboard shortcut',
        'Five themes',
        'Local history and custom words',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
      potentialAction: [
        { '@type': 'DownloadAction', name: 'Download for macOS', target: c.common.downloadUrl },
        { '@type': 'DownloadAction', name: 'Download for Windows beta', target: c.common.windowsUrl },
      ],
      author: { '@id': `${enUrl}#organization` },
      publisher: { '@id': `${enUrl}#organization` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: c.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={c.htmlLang} data-type="software">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content="Hush" />
    <meta name="application-name" content="Hush" />
    <meta name="apple-mobile-web-app-title" content="Hush" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta name="theme-color" content="#f7f3ef" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hush" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.meta.title} />
    <meta name="twitter:description" content={c.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={c.meta.ogAlt} />
    <meta name="twitter:url" content={canonicalUrl} />

    <link rel="icon" href={asset('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={asset('/icon-192.png')} sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/site.webmanifest')} />
    <link rel="sitemap" href={asset('/sitemap.xml')} />

    <link rel="stylesheet" href={asset('/fonts/fonts.css')} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={asset('/fonts/manrope-latin.woff2')}
      crossorigin
    />
    {lang === 'ru' && (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={asset('/fonts/manrope-cyrillic.woff2')}
        crossorigin
      />
    )}

    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(jsonLd)}</script>`} />
  </head>
  <body class:list={['page', `lang-${lang}`]}>
    <a class="skip-link" href="#main">{lang === 'ru' ? 'Перейти к содержимому' : 'Skip to content'}</a>
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
